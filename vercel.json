{
  "version": 2,
  "functions": {
    "api/v2/[...path].js": {
      "runtime": "@vercel/node@5.0.0",
      "memory": 256
    },
    "api/v1/[...path].js": {
      "runtime": "@vercel/node@5.0.0",
      "memory": 256
    }
  },
  "rewrites": [
    {
      "source": "/api/v1/(.*)",
      "destination": "/api/v1/[...path]"
    },
    {
      "source": "/api/v2/(.*)",
      "destination": "/api/v2/[...path]"
    },
    {
      "source": "/((?!api/).*)",
      "destination": "/index.html"
    }
  ]
}